# AI Annotator Configuration (for batch annotation)
# Get your API key from https://platform.deepseek.com/api_keys
AI_ANNOTATOR_API_KEY=sk-your-api-key-here
AI_ANNOTATOR_API_BASE=https://api.deepseek.com/v1
AI_ANNOTATOR_MODEL=deepseek-chat

# Data source paths (optional, defaults work for Windows)
# LANGFUSE_ROOT=<path to langfuse langfuse-local-workflow>
# EVAL_ROOT=<path to batch-runner>

# Langfuse Direct API (used by pipelines/feedback_extraction/fetch_and_import.py)
# Get keys from Langfuse project settings -> API Keys
LANGFUSE_HOST=https://agentos.hqzyai.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
# API path prefix: empty = standard /api/public; set /ai-observability if reverse-proxied
LANGFUSE_API_PATH_PREFIX=
# Time window in days for initial fetch
LANGFUSE_FETCH_DAYS=30
# Annotation batch size (02 script candidate count)
LANGFUSE_ANNOTATION_BATCH_SIZE=300

# Observation KPI cache TTL (seconds) - stale-while-revalidate (0.10 Phase 1)
FLYWHEEL_CACHE_TTL_SECONDS=60
