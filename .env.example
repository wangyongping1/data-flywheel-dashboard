# AI Annotator Configuration (for batch annotation)
# Get your API key from https://platform.deepseek.com/api_keys
AI_ANNOTATOR_API_KEY=sk-your-api-key-here
AI_ANNOTATOR_API_BASE=https://api.deepseek.com/v1
AI_ANNOTATOR_MODEL=deepseek-chat

# Data source paths (optional, defaults work for Windows)
# LANGFUSE_ROOT=C:/myfile/A-huaqing/langfuse/langfuse-local-workflow
# EVAL_ROOT=C:/myfile/A-huaqing/后训练/batch-runner
